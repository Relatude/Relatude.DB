<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? title + " - " : "")__NAME__</title>
    @if (ViewData["Description"] is string description) {
        <meta name="description" content="@description" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Index">__NAME__</a>
            <a href="/relatude.db">Admin UI</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        <small>&copy; @DateTime.UtcNow.Year __NAME__ &middot; built on <a href="https://db.relatude.com">Relatude.DB</a></small>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
