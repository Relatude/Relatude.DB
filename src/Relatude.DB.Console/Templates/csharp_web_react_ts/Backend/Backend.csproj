<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>__NAMESPACE__</RootNamespace>
    <ClientDir>$(MSBuildProjectDirectory)/../Client</ClientDir>
    <!-- .NET 9+ enables DATAS by default with Server GC; the engine holds large resident indexes, so keep the pre-.NET 9 behaviour -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <!-- relatude.data/ is this machine's database, and relatude.data.temp/ its scratch folder: keep them out of the
         build output and the publish folder, so a deployment never carries them onto a server -->
    <DefaultItemExcludes>$(DefaultItemExcludes);relatude.data\**;relatude.data.temp\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Relatude.DB.Server" Version="__PACKAGE_VERSION__" />
  </ItemGroup>

  <!-- On publish, build the React client into wwwroot so one deployment holds both. -->
  <Target Name="BuildClient" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm install" WorkingDirectory="$(ClientDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />
    <ItemGroup>
      <Content Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
