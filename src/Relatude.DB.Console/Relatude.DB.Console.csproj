<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- both: the tool reflects over the application's model assembly, which only loads on a runtime at
		     least as new as the one it was built for. "dotnet tool install" picks the newest the machine has. -->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- NOT Relatude.DB.Console: a namespace named Console would shadow System.Console -->
		<RootNamespace>Relatude.DB.Cli</RootNamespace>
		<AssemblyName>relatude</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
		<Version>0.4.0.190</Version>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>relatude</ToolCommandName>
		<PackageId>Relatude.DB.Tool</PackageId>
		<Description>Command line tool for Relatude.DB: create a new web application (relatude new), inspect the datamodel, run queries, generate model code and run maintenance on a local database.</Description>
		<!-- package metadata, kept in sync with the .nuspec files in \nuget -->
		<Authors>Ole Gulbrandsen</Authors>
		<PackageProjectUrl>https://www.github.com/relatude/relatude.db</PackageProjectUrl>
		<PackageTags>Database ORM CMS dotnet-tool</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageLicenseFile>license.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\readme.md" Pack="true" PackagePath="readme.md" Visible="false" />
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="license.txt" Visible="false" />
		<None Include="..\..\nuget\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- the project template "relatude new" writes: embedded as text, never compiled as part of this tool -->
		<Compile Remove="Templates\**" />
		<None Remove="Templates\**" />
		<EmbeddedResource Include="Templates\**" LogicalName="Templates/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- the server library is an ASP.NET Core library; its settings and container handling is reused as is -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Relatude.DB.NodeServer\Relatude.DB.NodeServer.csproj" />
		<!-- referenced so every engine a relatude.db.json may name can be loaded by LateBindings -->
		<ProjectReference Include="..\Relatude.DB.Providers\Relatude.DB.Providers.csproj" />
		<ProjectReference Include="..\Relatude.DB.Lucene\Relatude.DB.Lucene.csproj" />
		<ProjectReference Include="..\Relatude.DB.Sqlite\Relatude.DB.Sqlite.csproj" />
	</ItemGroup>

</Project>
