<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<RootNamespace>Relatude.DB</RootNamespace>
		<Version>0.4.0.190</Version>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="NodeServer\EventHub\**" />
	  <Compile Remove="NodeServer\EventTriggers\**" />
	  <Content Remove="NodeServer\EventHub\**" />
	  <Content Remove="NodeServer\EventTriggers\**" />
	  <EmbeddedResource Remove="NodeServer\EventHub\**" />
	  <EmbeddedResource Remove="NodeServer\EventTriggers\**" />
	  <None Remove="NodeServer\ClientUI\**" />
	  <None Remove="NodeServer\EventHub\**" />
	  <None Remove="NodeServer\EventTriggers\**" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Relatude.DB.DataStoreLocal\Relatude.DB.DataStoreLocal.csproj" />
		<ProjectReference Include="..\Relatude.DB.DataStoreRemote\Relatude.DB.DataStoreRemote.csproj" />
		<ProjectReference Include="..\Relatude.DB.NodeStore\Relatude.DB.NodeStore.csproj" />
		<ProjectReference Include="..\Relatude.DB.Providers\Relatude.DB.Providers.csproj" />
		<ProjectReference Include="..\Relatude.DB.TextIndex\Relatude.DB.TextIndex.csproj" />
		<ProjectReference Include="..\Relatude.DB.VectorIndex\Relatude.DB.VectorIndex.csproj" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="NodeServer\ClientStart\start.html" />
		<EmbeddedResource Include="NodeServer\ClientUI\**" />
	</ItemGroup>
	<!-- NodeServer\ClientUI is the vite output of src\Relatude.DB.UI (see its vite.config.ts) and is
	     embedded above. It is the whole admin UI: a build made without it serves an explanatory 501 on
	     the admin url instead of the UI, so it is called out here rather than discovered in a browser. -->
	<Target Name="WarnWhenAdminUINotBuilt" BeforeTargets="CoreCompile">
		<Warning Condition="!Exists('$(MSBuildProjectDirectory)\NodeServer\ClientUI\index.html') Or !Exists('$(MSBuildProjectDirectory)\NodeServer\ClientUI\index.js') Or !Exists('$(MSBuildProjectDirectory)\NodeServer\ClientUI\index.css')" Text="The admin UI is missing from NodeServer\ClientUI and will not be embedded in this build. Run &quot;npm install&quot; and &quot;npm run build&quot; in src\Relatude.DB.UI, then build again." />
	</Target>
</Project>
