{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "relatude-db-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "src/Relatude.DB.UI"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "website-basic",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "examples/Website.Basic",
        "--no-launch-profile",
        "--urls",
        "http://localhost:5052"
      ],
      "port": 5052,
      "autoPort": false
    },
    {
      "name": "cms-website4",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "../Relatude.DB.CMS/Website4",
        "--no-launch-profile",
        "--urls",
        "http://localhost:5064"
      ],
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "port": 5064,
      "autoPort": false
    },
    {
      "name": "cms-ui-website4",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "../Relatude.DB.CMS/Relatude.CMS.UI/node_modules/vite/bin/vite.js",
        "../Relatude.DB.CMS/Relatude.CMS.UI/packages/cms",
        "--host",
        "127.0.0.1",
        "--port",
        "5179",
        "--strictPort"
      ],
      "env": {
        "RELATUDE_SITE": "http://localhost:5064"
      },
      "port": 5179,
      "autoPort": false,
      "url": "http://127.0.0.1:5179"
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "docs"
      ],
      "port": 8765,
      "autoPort": false
    }
  ]
}
