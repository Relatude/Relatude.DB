{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "relatude-db-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "src/Relatude.DB.UI"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "website-basic",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "examples/Website.Basic",
        "--no-launch-profile",
        "--urls",
        "http://localhost:5052"
      ],
      "port": 5052,
      "autoPort": false
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "docs"
      ],
      "port": 8765,
      "autoPort": false
    }
  ]
}
