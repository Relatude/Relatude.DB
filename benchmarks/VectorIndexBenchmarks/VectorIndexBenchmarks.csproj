<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- the three Relatude implementations: MemorySemanticIndex lives in DataStoreLocal (internal,
         reached through InternalsVisibleTo), the two disk indexes each in their own assembly -->
    <ProjectReference Include="..\..\src\Relatude.DB.DataStoreLocal\Relatude.DB.DataStoreLocal.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.VectorIndex\Relatude.DB.VectorIndex.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.VectorIndexHNSW\Relatude.DB.VectorIndexHNSW.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.VectorIndexHNSW2\Relatude.DB.VectorIndexHNSW2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the two third-party implementations benchmarked alongside them. Both ship their native
         libraries under runtimes/<rid>/native/ and support win-x64, linux-x64 and macOS.
         Microsoft.Data.Sqlite is pinned to the version Relatude.DB.Sqlite already uses. -->
    <PackageReference Include="Cloud.Unum.USearch" Version="2.26.0" />
    <PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0.137</Version>
  </PropertyGroup>

</Project>
