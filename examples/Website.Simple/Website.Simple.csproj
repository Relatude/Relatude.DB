<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.0.192</Version>
    <UserSecretsId>632dd380-1f0a-4c10-9ba8-613a16d4b33f</UserSecretsId>
    <!-- .NET 9+ enables DATAS by default with Server GC; the engine holds large resident indexes, so keep the pre-.NET 9 behaviour -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Models/CSharp holds CSharpCodeFile datamodel sources: compiled by Relatude.DB when the
         store opens, not by the project build (see relatude.db.json and Models/CSharp/Campaign.cs) -->
    <Compile Remove="Models\CSharp\**" />
    <None Include="Models\CSharp\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Relatude.DB.GraphQL\Relatude.DB.GraphQL.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.NodeServer\Relatude.DB.NodeServer.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.Sqlite\Relatude.DB.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.Lucene\Relatude.DB.Lucene.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.Providers\Relatude.DB.Providers.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.FFMpeg\Relatude.DB.FFMpeg.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.Skia\Relatude.DB.Skia.csproj" />
    <ProjectReference Include="..\..\src\Relatude.DB.TextIndex\Relatude.DB.TextIndex.csproj" />
  </ItemGroup>

</Project>
