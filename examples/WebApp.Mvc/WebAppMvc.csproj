<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebAppMvc</RootNamespace>
    <!-- .NET 9+ enables DATAS by default with Server GC; the engine holds large resident indexes, so keep the pre-.NET 9 behaviour -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <Version>0.4.0.192</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Relatude.DB.Server" Version="0.3.0.187-alpha" />
    <PackageReference Include="Relatude.DB.Plugins.Skia" Version="0.3.0.187-alpha" />
    <PackageReference Include="Relatude.DB.Plugins.FFMpeg" Version="0.3.0.187-alpha" />
  </ItemGroup>

</Project>
