<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClientDir>$(MSBuildProjectDirectory)\..\..\Client</ClientDir>
    <Version>0.2.0.161</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Relatude.DB.Plugins.FFMpeg" Version="0.2.0.160-alpha" />
    <PackageReference Include="Relatude.DB.Plugins.Skia" Version="0.2.0.160-alpha" />
    <PackageReference Include="Relatude.DB.Server" Version="0.2.0.160-alpha" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <!-- On publish, build the React client into wwwroot. -->
  <Target Name="BuildClient" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm install" WorkingDirectory="$(ClientDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />
    <ItemGroup>
      <Content Include="wwwroot\**" Exclude="wwwroot\.gitignore" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
